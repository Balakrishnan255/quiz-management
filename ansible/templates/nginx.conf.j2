# ansible/templates/nginx.conf.j2
# ─────────────────────────────────────────────────────────────────────────────
# Nginx virtual-host with full HTTPS and Let's Encrypt SSL.
# ─────────────────────────────────────────────────────────────────────────────

# ── 1. HTTP to HTTPS Redirect ─────────────────────────────────────────────────
server {
    listen 80;
    server_name quizapp-bala.indiasouthcentral.cloudapp.azure.com _;
    return 301 https://$host$request_uri;
}

# ── 2. HTTPS Main Application Server ──────────────────────────────────────────
server {
    listen 443 ssl;
    server_name quizapp-bala.indiasouthcentral.cloudapp.azure.com;

    ssl_certificate /etc/letsencrypt/live/quizapp-bala.indiasouthcentral.cloudapp.azure.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/quizapp-bala.indiasouthcentral.cloudapp.azure.com/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

    # ── React SPA ──────────────────────────────────────────────────────────
    root {{ frontend_build_dir }};
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    # ── Backend API proxy ──────────────────────────────────────────────────
    location /api/ {
        proxy_pass         http://127.0.0.1:{{ backend_port }};
        proxy_http_version 1.1;
        proxy_set_header   Upgrade $http_upgrade;
        proxy_set_header   Connection 'upgrade';
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_cache_bypass $http_upgrade;
    }
}
