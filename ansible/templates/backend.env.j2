# ansible/templates/backend.env.j2
# ─────────────────────────────────────────────────────────────────────────────
# This Jinja2 template is rendered on the target server by Ansible.
# Values come from Ansible vars (passed via --extra-vars from the Jenkinsfile).
# ─────────────────────────────────────────────────────────────────────────────
PORT=5000
DB_HOST={{ db_host }}
DB_PORT={{ db_port }}
DB_USER={{ db_user }}
DB_PASSWORD={{ db_password }}
DB_NAME={{ db_name }}
JWT_SECRET={{ jwt_secret }}
JWT_EXPIRES_IN={{ jwt_expires_in }}
NODE_ENV=production
